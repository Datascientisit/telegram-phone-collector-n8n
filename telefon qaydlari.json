    {
      "parameters": {
        "jsCode": "const message = $input.item.json.message || {};\nconst text = message.text || '';\nconst contact = message.contact || null;\nconst replyTo = message.reply_to_message || null;\nconst timestamp = $now.setZone('Asia/Tashkent').toFormat('dd.MM.yyyy');\n\n\n// O'zbekiston operator kodlari\nconst validCodes = ['33','88','90','91','93','94','95','97','98','99','20','50'];\n\nfunction normalizePhone(digitsRaw) {\n  const digits = digitsRaw.replace(/\\D/g, '');\n  let nineDigits = null;\n  if (digits.length === 9) {\n    nineDigits = digits;\n  } else if (digits.length === 12 && digits.startsWith('998')) {\n    nineDigits = digits.slice(3);\n  }\n  if (nineDigits && validCodes.includes(nineDigits.slice(0, 2))) {\n    return '+998' + nineDigits;\n  }\n  return null;\n}\n\nfunction isCapitalized(word) {\n  return /^[A-ZА-ЯЁ]/.test(word);\n}\n\n\n\nfunction normalizePhone(digitsRaw) {\n  const digits = digitsRaw.replace(/\\D/g, '');\n\n  // Avval 998 bilan boshlangan holatni tekshiramiz\n  if (digits.length >= 12 && digits.startsWith('998')) {\n    const sub = digits.slice(3, 12);\n    if (validCodes.includes(sub.slice(0, 2))) {\n      return '+998' + sub;\n    }\n  }\n\n  // Keyin, qolgan raqamlar ichidan 9 xonali \"oyna\" (window) qidiramiz\n  for (let i = 0; i <= digits.length - 9; i++) {\n    const sub = digits.slice(i, i + 9);\n    if (validCodes.includes(sub.slice(0, 2))) {\n      return '+998' + sub;\n    }\n  }\n\n  return null;\n}\nfunction extractName(str) {\n  if (!str) return '';\n  const idx = str.search(/raqam/i);\n  if (idx === -1) return '';\n\n  const before = str.slice(0, idx).trim();\n  if (!before) return '';\n\n  const words = before.split(/\\s+/);\n  const last = words[words.length - 1];\n  const isTitleWord = /^(aka|opa)/i.test(last);\n\n  if (isTitleWord && words.length >= 2) {\n    const namePart = words[words.length - 2];\n    if (!isCapitalized(namePart)) return '';\n    return namePart + ' ' + normalizeTitle(last);\n  }\n\n  if (!isCapitalized(last)) return '';\n  return last;\n}\n\n// ============ 1) RAQAMNI TOPISH ============\nlet phoneFound = false;\nlet formattedPhone = '';\nlet rawPhone = null;\nlet source = '';\n\nif (contact && contact.phone_number) {\n  const normalized = normalizePhone(contact.phone_number);\n  if (normalized) {\n    phoneFound = true;\n    formattedPhone = normalized;\n    rawPhone = contact.phone_number;\n    source = 'contact';\n  }\n}\n\nif (!phoneFound && text) {\n  const regex = /\\+?\\d[\\d\\s\\-.()]{6,17}\\d/g;\n  const candidates = text.match(regex) || [];\n  for (const candidate of candidates) {\n    const normalized = normalizePhone(candidate);\n    if (normalized) {\n      phoneFound = true;\n      formattedPhone = normalized;\n      rawPhone = candidate.trim();\n      source = 'text';\n      break;\n    }\n  }\n}\n\n// ============ 2) KIMDAN KELGANI (aniq, Telegram ma'lumoti) ============\nconst senderName = message.from?.first_name || '';\nconst senderUsername = message.from?.username || '';\nconst senderId = message.from?.id || '';\n\n// ============ 3) KIM SO'RADI (aniq, agar reply bo'lsa) ============\nconst isReply = !!replyTo;\nconst askerName = replyTo?.from?.first_name || '';\nconst askerUsername = replyTo?.from?.username || '';\nconst repliedText = replyTo ? (replyTo.text || '') : '';\n\n// ============ 4) RAQAM EGASI (taxminiy, matn tahlili) ============\nlet phoneOwner = '';\nlet ownerSource = '';\n\nif (contact) {\n  phoneOwner = `${contact.first_name || ''} ${contact.last_name || ''}`.trim();\n  ownerSource = 'contact';\n} else if (isReply && repliedText) {\n  const nameFromReply = extractName(repliedText);\n  if (nameFromReply) {\n    phoneOwner = nameFromReply;\n    ownerSource = 'reply_text';\n  }\n}\n\nif (!phoneOwner && text) {\n  const nameFromText = extractName(text);\n  if (nameFromText) {\n    phoneOwner = nameFromText;\n    ownerSource = 'message_text';\n  }\n}\n\nif (!phoneOwner) {\n  phoneOwner = 'Aniqlanmagan';\n  ownerSource = 'unknown';\n}\n\n// ============ NATIJA ============\nreturn {\n  json: {\n    phoneFound,\n    rawPhone,\n    phoneNumber: formattedPhone,\n    source,\n\n    senderName,\n    senderUsername,\n    senderId,\n\n    isReply,\n    askerName,\n    askerUsername,\n    repliedText,\n\n    phoneOwner,\n    ownerSource,\n\n    messageText: text,\n    timestamp,\n  }\n};"
      },
